    "Setting a clear sleep goal can help regulate your body's internal clock.": {
      "comment": "Onboarding bedtime page subtitle (used on initial onboarding only)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد هدف نوم واضح يساعد في تنظيم ساعة جسمك الداخلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
