          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting a clear sleep goal can help regulate your body's internal clock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar un objetivo de sueño claro ayuda a regular tu reloj interno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixer un objectif de sommeil clair aide à réguler ton horloge interne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पष्ट नींद का लक्ष्य आपके शरीर की आंतरिक घड़ी को नियमित करने में मदद करता है।"
          }
        },
        "it": {
          "stringUnit": {
