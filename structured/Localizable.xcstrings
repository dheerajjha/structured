          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks without a scheduled time live here.\nGreat for capturing ideas and to-dos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí van las tareas sin hora fijada.\nIdeal para apuntar ideas y pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches sans heure définie atterrissent ici.\nParfait pour noter idées et choses à faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन कार्यों के लिए समय तय नहीं है, वे यहाँ रहते हैं।\nविचार और टू-डू लिखने के लिए बढ़िया जगह।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui ci sono le attività senza un orario fissato.\nPerfetto per annotare idee e cose da fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間が決まっていないタスクはここに入ります。\nアイデアやToDoのメモにぴったりです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 정해지지 않은 작업이 이곳에 모입니다.\n아이디어와 할 일을 적어두기에 좋습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas sem horário ficam aqui.\nÓtimo para anotar ideias e afazeres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
