    "Tasks without a scheduled time live here.\nGreat for capturing ideas and to-dos.": {
      "comment": "Empty-state body on Inbox tab. \\n is a literal line break — keep it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا توجد المهام التي بلا وقت محدد.\nمكان رائع لتدوين الأفكار وقوائم المهام."
          }
        },
        "de": {
          "stringUnit": {
