    "Rise and Shine will use this time on new days.": {
      "comment": "Settings sheet subtitle when changing the wake-up time. Translate Rise and Shine to the same idiomatic phrase used elsewhere in this catalog.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
