    "Just tell the AI what you want in plain English. It will act immediately — no confirmation needed.": {
      "comment": "AI help sheet intro paragraph. Translate idiomatically — 'plain English' means everyday language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط أخبر الذكاء الاصطناعي بما تريد بلغة عادية. سيُنفّذ ذلك فورًا — دون تأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag der KI einfach in normaler Sprache, was du möchtest. Sie handelt sofort – ohne Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just tell the AI what you want in plain English. It will act immediately — no confirmation needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo dile a la IA lo que quieres con palabras normales. Lo hará al instante, sin confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis simplement à l'IA ce que tu veux dans un langage courant. Elle agit immédiatement, sans confirmation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI को सामान्य भाषा में बताएं कि आप क्या चाहते हैं। वह तुरंत काम करेगा — पुष्टि की ज़रूरत नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' all'IA cosa vuoi in linguaggio naturale. Agirà subito, senza chiedere conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やりたいことを普段の言葉でAIに伝えてください。確認なしで、すぐに実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평범한 말로 AI에게 원하는 것을 말씀하세요. 확인 없이 바로 실행해 드립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É só dizer à IA o que você quer, em linguagem natural. Ela faz na hora — sem confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просто скажите ИИ обычными словами, что нужно сделать. Он сразу выполнит, без подтверждения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用日常语言告诉 AI 你想做什么，它会立刻执行，无需确认。"
          }
        }
      }
    },
